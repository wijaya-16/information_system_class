# Konfigurasi Backend PostgreSQL Kelas SI
PORT=5000

# 1. Konfigurasi PostgreSQL Lokal (Laptop Ini)
# Port PostgreSQL Anda (5432 untuk v18 atau 5433 untuk v16)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=kelas_si

# 2. Atau Konfigurasi Cloud PostgreSQL (Neon / Supabase / Aiven / Railway):
# Cukup un-comment baris di bawah dan isi URL koneksi dari penyedia cloud:
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

