# ============================================
# FIREBASE CONFIGURATION - KELAS SI APP
# ============================================
# Salin file ini menjadi .env lalu isi dengan
# konfigurasi Firebase project kamu.
#
# Cara mendapatkan config:
# 1. Buka https://console.firebase.google.com
# 2. Buat project baru (atau pakai yang ada)
# 3. Klik ikon </> (Web App) untuk register app
# 4. Copy konfigurasi di bawah ini

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

